<?xml version="1.0"?>
<robot name="chackras">

  <!-- ========================= -->
  <!-- CHASIS                    -->
  <!-- ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.20"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.18"
        ixy="0.0"
        ixz="0.0"
        iyy="0.33"
        iyz="0.0"
        izz="0.43"/>
    </inertial>
  </link>


  <!-- ========================= -->
  <!-- RUEDA DELANTERA IZQUIERDA -->
  <!-- ========================= -->

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="front_left_wheel"/>

    <origin xyz="0.20 0.225 0.10"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- RUEDA DELANTERA DERECHA   -->
  <!-- ========================= -->

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="front_right_wheel"/>

    <origin xyz="0.20 -0.225 0.10"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- RUEDA TRASERA IZQUIERDA   -->
  <!-- ========================= -->

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="rear_left_wheel"/>

    <origin xyz="-0.20 0.225 0.10"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- RUEDA TRASERA DERECHA     -->
  <!-- ========================= -->

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="rear_right_wheel"/>

    <origin xyz="-0.20 -0.225 0.10"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- ROS2 CONTROL              -->
  <!-- ========================= -->

  <ros2_control name="RobotSystem" type="system">

    <hardware>

      <!-- <plugin>mock_components/GenericSystem</plugin> -->

      <plugin>my_robot_hardware/MiRobotHardware</plugin>

    </hardware>


    <!-- ========================== -->
    <!-- MOTOR RUEDA DELANTERA IZQ. -->
    <!-- ========================== -->

    <joint name="front_left_wheel_joint">

      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
   
      <state_interface name="current"/>

    </joint>


    <!-- ========================== -->
    <!-- MOTOR RUEDA DELANTERA DER. -->
    <!-- ========================== -->

    <joint name="front_right_wheel_joint">

      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
     
      <state_interface name="current"/>


    </joint>


    <!-- ========================== -->
    <!-- MOTOR RUEDA TRASERA IZQ.   -->
    <!-- ========================== -->

    <joint name="rear_left_wheel_joint">

      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
      
      <state_interface name="current"/>

    </joint>


    <!-- ========================== -->
    <!-- MOTOR RUEDA TRASERA DER.   -->
    <!-- ========================== -->

    <joint name="rear_right_wheel_joint">

      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
     
      <state_interface name="current"/>

    </joint>

  </ros2_control>

</robot>